{
	"name": "carbonio-files-public-folder-ui",
	"description": "Files Public Folder module",
	"private": true,
	"version": "0.0.20",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": "v22",
		"pnpm": ">=10"
	},
	"scripts": {
		"bump-version": "semantic-release",
		"dev": "vite",
		"prebuild": "rm -rf dist/*",
		"build": "tsc && vite build",
		"build:dev": "pnpm run build --mode=development",
		"lint": "eslint src --report-unused-disable-directives --max-warnings 0 --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs",
		"lint:fix": "pnpm run lint --fix",
		"prepreview": "pnpm run build --mode preview",
		"preview": "vite preview --mode preview",
		"test": "vitest run",
		"prepare": "is-ci || husky",
		"type-check": "tsc --noEmit",
		"codegen": "graphql-codegen --config codegen.ts"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@zextras/carbonio-design-system": "12.0.4",
		"graphql": "16.14.1",
		"i18next": "26.3.1",
		"i18next-browser-languagedetector": "8.2.1",
		"i18next-http-backend": "4.0.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"react-i18next": "17.0.8"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.0",
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/types": "21.2.0",
		"@emotion/jest": "11.14.2",
		"@faker-js/faker": "10.5.0",
		"@graphql-codegen/add": "6.0.1",
		"@graphql-codegen/cli": "6.3.1",
		"@graphql-codegen/typed-document-node": "6.1.8",
		"@graphql-codegen/typescript": "5.0.10",
		"@graphql-codegen/typescript-operations": "5.1.0",
		"@graphql-eslint/eslint-plugin": "4.4.0",
		"@graphql-typed-document-node/core": "3.2.0",
		"@semantic-release/changelog": "6.0.3",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/git": "10.0.1",
		"@semantic-release/github": "12.0.8",
		"@semantic-release/npm": "13.1.5",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@testing-library/dom": "10.4.1",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react-swc": "3.11.0",
		"@vitest/coverage-v8": "3.2.6",
		"@zextras/carbonio-ui-configs": "2.1.0",
		"eslint": "8.57.1",
		"eslint-plugin-notice": "1.0.0",
		"eslint-plugin-react-refresh": "0.4.26",
		"husky": "9.1.7",
		"is-ci": "4.1.0",
		"jsdom": "29.1.1",
		"msw": "2.14.6",
		"semantic-release": "25.0.5",
		"sonarqube-scanner": "4.3.8",
		"typescript": "5.9.3",
		"vite": "6.4.3",
		"vite-plugin-static-copy": "3.4.0",
		"vitest": "3.2.6"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@swc/core",
			"core-js",
			"esbuild",
			"msw",
			"unrs-resolver"
		]
	},
	"msw": {
		"workerDirectory": "public"
	},
	"config": {
		"translations_repository": "git@github.com:Zextras/carbonio-files-ui-i18n.git"
	},
	"carbonio": {
		"name": "carbonio-files-public-folder-ui"
	}
}
