{
  "name": "carbonio-files-public-folder-ui",
  "description": "Files Public Folder module",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "rm -rf dist/*",
    "build": "tsc && vite build",
    "build:dev": "npm run build -- --mode=development",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0 --resolve-plugins-relative-to node_modules/@zextras/carbonio-ui-configs",
    "lint:fix": "npm run lint -- --fix",
    "prepreview": "npm run build -- --mode preview",
    "preview": "vite preview --mode preview",
    "test": "vitest run",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@zextras/carbonio-design-system": "^11.0.0-devel.1",
    "graphql": "^16.10.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "i18next-http-backend": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "@faker-js/faker": "^9.7.0",
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/typed-document-node": "^5.1.1",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.0",
    "@graphql-eslint/eslint-plugin": "^4.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "@vitest/coverage-v8": "^3.1.2",
    "@zextras/carbonio-ui-configs": "^2.1.0",
    "eslint-plugin-notice": "^1.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "msw": "^2.7.4",
    "typescript": "~5.8.2",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^2.3.1",
    "vitest": "^3.1.1"
  },
  "msw": {
    "workerDirectory": "public"
  },
  "config": {
    "translations_repository": "git@github.com:Zextras/carbonio-files-ui-i18n.git"
  },
  "carbonio": {
    "name": "carbonio-files-public-folder-ui"
  }
}
